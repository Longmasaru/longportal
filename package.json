{
  "name": "long-portal",
  "version": "0.1.0",
  "private": true,
  "description": "株式会社ロング 社内ポータル基盤(モジュラーモノリス)",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "sync:manifests": "tsx --env-file=.env.local scripts/sync-manifests.ts",
    "db:grant-admin": "tsx --env-file=.env.local scripts/grant-system-admin.ts",
    "db:import-employees": "tsx --env-file=.env.local scripts/import-employees.ts",
    "db:issue-accounts": "tsx --env-file=.env.local scripts/issue-accounts.ts",
    "db:reset-password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "db:update-name-kana": "tsx --env-file=.env.local scripts/update-name-kana.ts",
    "db:import-birth-dates": "tsx --env-file=.env.local scripts/import-birth-dates.ts",
    "db:import-haisou": "tsx --env-file=.env.local scripts/import-haisou.ts",
    "db:import-kyokasho": "tsx --env-file=.env.local scripts/import-kyokasho.ts",
    "r2:check": "tsx --env-file=.env.local scripts/r2-check.ts",
    "lineworks:setup": "tsx --env-file=.env.local scripts/lineworks-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "bcryptjs": "3.0.3",
    "budoux": "0.9.3",
    "drizzle-orm": "0.45.3",
    "mammoth": "1.13.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "node-html-parser": "9.0.4",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
