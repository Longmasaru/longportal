# LONG PORTAL 環境変数の雛形。
# ローカルは .env.local にコピーして値を入れる(.env.local はコミットしない)。
# 本番・Preview は Vercel の Environment Variables に設定する。

# アプリ実行時に使う接続(Neon の pooled connection / ホスト名に "-pooler" を含む)
DATABASE_URL=

# migration 専用の接続(Neon の direct connection / pooler なし)
DATABASE_URL_UNPOOLED=

# Auth.js の JWT 署名用シークレット(手順2で使用)。
# 生成例: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=

# DB の向き先の明示(本番への誤実行防止)。migration / seed はこの値を検査する。
# ローカル開発は development。production は Vercel など本番側でのみ設定し、
# 本番への migration は CONFIRM_PRODUCTION=yes を付けて明示的に実行する。
DB_TARGET=development

# 初期管理者(開発・初回セットアップ用)。npm run db:seed が、ユーザーが 1 人もいないときだけ作成する。
# 初回ログイン時にパスワード変更が必須になる。変更後は .env.local からこの 2 行を削除してよい。
SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_PASSWORD=

# 別プロジェクトのアプリへの通行証の署名の鍵(docs/DESIGN.md 28 章)。アプリ側の SSO_SECRET と同じ値。32 文字以上。
# 生成例: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
SSO_SECRET_AIKYOSHITSU=
# AI教室の転送先(ポータルの /aikyoshitsu/… をこのアプリへ転送する)。未設定なら本番の https://ai-kyoshitsu.vercel.app。手元では http://localhost:3001
AIKYOSHITSU_ORIGIN=

# 配達ルート(docs/DESIGN.md 29 章)の Google Maps Platform の鍵。Geocoding API と Routes API を有効にしたもの。
# 未設定でも動くが、ルートは 1 区間 15 分の概算になり、住所の地図確認は使えない。
GOOGLE_MAPS_API_KEY=

# LINE WORKS の Bot(docs/DESIGN.md 33 章)。Developer Console の API 2.0 のアプリ(OAuth Scopes に bot)と Bot の値。
# 未設定なら知らせを送らない(ほかの動きは変わらない)。秘密鍵は 1 行にして、改行を \n と書いてもよい。
LINEWORKS_CLIENT_ID=
LINEWORKS_CLIENT_SECRET=
LINEWORKS_SERVICE_ACCOUNT=
LINEWORKS_PRIVATE_KEY=
LINEWORKS_BOT_ID=
# 教科書のツッコミを知らせるトークルーム(npm run lineworks:setup で作って表示された channelId)。
# 教科書ごと・部署ごとのトークルームは JSON で {"教科書の slug か部署名":"channelId"}(slug を先に見る)。どちらにもないもの(全部署共通など)は全体用へ送る。
KYOKASHO_LINEWORKS_CHANNELS=
KYOKASHO_LINEWORKS_CHANNEL_ID=
